{
  "info": {
    "name": "Chat Backend API Collection",
    "description": "Complete collection for Chat Backend Machine Round task with PostgreSQL/MySQL and Firebase Firestore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userAId", "value": "usr_alice_001" },
    { "key": "userBId", "value": "usr_bob_002" },
    { "key": "chatId", "value": "" },
    { "key": "messageId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "1. Create User A",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/user", "host": ["{{baseUrl}}"], "path": ["user"] }
      }
    },
    {
      "name": "2. Create User B",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob Smith\",\n  \"email\": \"bob@example.com\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/user", "host": ["{{baseUrl}}"], "path": ["user"] }
      }
    },
    {
      "name": "3. [Req 1] Create or Get 1:1 Chat",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"{{userBId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/chat/create", "host": ["{{baseUrl}}"], "path": ["chat", "create"] }
      }
    },
    {
      "name": "4. [Req 2] Send Message",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hello Bob, how is the project going?\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/chat/{{chatId}}/message/send", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}", "message", "send"] }
      }
    },
    {
      "name": "5. [Req 3] Get Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "messages"],
          "query": [{ "key": "limit", "value": "50" }]
        }
      }
    },
    {
      "name": "6. [Req 4] Mark Message Read",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}", "message", "{{messageId}}", "read"] }
      }
    },
    {
      "name": "7. [Req 5] Update Last Seen",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\",\n  \"messageId\": \"{{messageId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/chat/{{chatId}}/lastseen", "host": ["{{baseUrl}}"], "path": ["chat", "{{chatId}}", "lastseen"] }
      }
    },
    {
      "name": "8. [Req 6] List User Chats",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/user/{{userAId}}/chats", "host": ["{{baseUrl}}"], "path": ["user", "{{userAId}}", "chats"] }
      }
    }
  ]
}
