# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Relational Database (MySQL / PostgreSQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/chat_backend_db"

# Firebase / Firestore Configuration
# Option 1: Path to Firebase Service Account JSON (Production / Live Cloud)
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Option 2: Direct credentials via environment variables
FIREBASE_PROJECT_ID="chat-backend-dev"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@chat-backend-dev.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Option 3: Local Firebase Emulator (Host and Port)
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# If neither live credentials nor emulator are supplied in development/test,
# the backend automatically uses an In-Memory Firestore Adapter so that
# APIs and tests work out-of-the-box with zero configuration blockers.
USE_IN_MEMORY_FIRESTORE=true
